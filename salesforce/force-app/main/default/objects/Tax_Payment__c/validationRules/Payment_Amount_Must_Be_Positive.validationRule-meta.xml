<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Amount_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Receipt payment amount must be greater than zero</description>
    <errorConditionFormula>ISBLANK(Amount_Paid__c) || Amount_Paid__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Amount_Paid__c</errorDisplayField>
    <errorMessage>Payment amount must be strictly greater than zero.</errorMessage>
</ValidationRule>

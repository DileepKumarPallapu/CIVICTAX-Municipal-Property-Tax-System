<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Construction_Year_Not_In_Future</fullName>
    <active>true</active>
    <description>Prevents future construction years</description>
    <errorConditionFormula>Construction_Year__c &gt; YEAR(TODAY())</errorConditionFormula>
    <errorDisplayField>Construction_Year__c</errorDisplayField>
    <errorMessage>Construction year cannot be in the future.</errorMessage>
</ValidationRule>

# Salesforce Environment Configuration for CivicTax 6.0 Express Backend

# Target Salesforce Login URL (Production / Trailhead Playground / Developer Edition)
# For Trailhead Playground with custom domain, you can also use your My Domain URL (e.g., https://curious-badger-xxxx.trailblaze.my.salesforce.com)
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce Connected App / External Client App OAuth 2.0 Credentials
# (Obtain from Salesforce Setup -> App Manager OR External Client App Manager)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# OAuth Callback URL (Must match Callback URL configured in Connected App OAuth Settings)
SF_REDIRECT_URI=http://localhost:3001/auth/salesforce/callback

# Salesforce REST / Apex REST API Version
SF_API_VERSION=v60.0

# Express Session Encryption Secret (Random 32+ character key)
SESSION_SECRET=civictax_super_secure_random_session_secret_key_2026_dev

# React Frontend Origin for CORS allowlist and redirects
FRONTEND_URL=http://localhost:5173

# Express Server Port
PORT=3001

# Runtime Environment (development / production)
NODE_ENV=development

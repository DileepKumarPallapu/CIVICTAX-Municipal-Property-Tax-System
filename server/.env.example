# CivicTax Backend Environment Configuration (Render service)

# Target Salesforce Login URL (Production / Trailhead Playground / Developer Edition)
# Default: https://login.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce External Client App / Connected App OAuth 2.0 Credentials
# (Obtain from Salesforce Setup -> Apps -> External Client App Manager)
SF_CLIENT_ID=YOUR_SALESFORCE_CONSUMER_KEY
SF_CLIENT_SECRET=YOUR_SALESFORCE_CONSUMER_SECRET
# Exact 15- or 18-character Salesforce org ID allowed to authenticate CivicTax users.
# Do not set this to a Dev Hub unless it is also the approved CivicTax authentication org.
SF_EXPECTED_ORG_ID=YOUR_APPROVED_SALESFORCE_ORG_ID
# Enable Authorization Code + PKCE and grant only the required api and id scopes for user login.

# Non-secret ID for the key pair used by the Apex REST request signer.
CIVICTAX_GATEWAY_KEY_ID=replace-with-approved-key-id
# Only configure alongside the same key in a managed-package protected setting.
# Never put a production HMAC key in the current unmanaged Public custom setting.
CIVICTAX_GATEWAY_SHARED_SECRET=YOUR_RANDOM_HMAC_SECRET_AT_LEAST_32_CHARACTERS

# OAuth Callback URL (Must match Callback URL configured in Salesforce External Client App)
# Local: http://localhost:3001/auth/salesforce/callback
# Production: https://civictax-municipal-property-tax-system.onrender.com/auth/salesforce/callback
SF_REDIRECT_URI=https://civictax-municipal-property-tax-system.onrender.com/auth/salesforce/callback

# Salesforce REST / Apex REST API Version
SF_API_VERSION=v60.0

# Express Session Encryption Secret (Random 32+ character key)
SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS

# Upstash Redis REST credentials (recommended for Upstash-hosted Redis)
# Required in production for shared sessions and encrypted Salesforce credential storage.
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Alternative Redis TCP URL (node-redis); leave unset when using the REST credentials above.
# Local development can omit Redis configuration and use the in-memory session store.
# REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_UPSTASH_ENDPOINT:6379

# React Frontend Origin for CORS allowlist and redirects
# Local: http://localhost:5173
# Production: https://civictax-municipal-property-tax-sys.vercel.app
FRONTEND_URL=https://civictax-municipal-property-tax-sys.vercel.app

# Server Port (Render supplies PORT; use 3001 for local development)
PORT=3001

# Runtime Environment ('development' or 'production')
NODE_ENV=production

# Salesforce Environment Configuration for CivicTax 8.0 Express Backend

# Target Salesforce Login URL (Production / Trailhead Playground / Developer Edition)
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce External Client App OAuth 2.0 Credentials
# (Obtain from Salesforce Setup -> Apps -> External Client Apps -> External Client App Manager)
SF_CLIENT_ID=YOUR_EXTERNAL_CLIENT_APP_CONSUMER_KEY
SF_CLIENT_SECRET=YOUR_EXTERNAL_CLIENT_APP_CONSUMER_SECRET

# OAuth Callback URL (Must match Callback URL configured in External Client App OAuth Settings)
SF_REDIRECT_URI=http://localhost:3001/auth/salesforce/callback

# Salesforce REST / Apex REST API Version
SF_API_VERSION=v60.0

# Express Session Encryption Secret (Random 32+ character key)
SESSION_SECRET=civictax_super_secure_random_session_secret_key_2026_dev

# React Frontend Origin for CORS allowlist and redirects
FRONTEND_URL=http://localhost:5173

# Express Server Port
PORT=3001

# Runtime Environment (development / production)
NODE_ENV=development

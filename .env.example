# CivicTax 10.0 Frontend Environment Configuration

# Application Operating Mode: 'local' (offline demo) or 'salesforce' (connected via Express Gateway)
VITE_DATA_PROVIDER=local

# CivicTax Backend API Gateway Base URL (Used when connecting via Express Gateway)
VITE_BACKEND_URL=http://localhost:3001

# Public Application Name
VITE_APP_NAME=CIVICTAX

# Default Language ('en' for English, 'ta' for Tamil)
VITE_DEFAULT_LANGUAGE=en

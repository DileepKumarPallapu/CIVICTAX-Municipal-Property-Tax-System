# CivicTax Frontend Environment Configuration (Vercel Project 1: Root Directory ./)

# Primary Backend API Base URL (CivicTax backend hosted on Render)
# Local: http://localhost:3001
# Production: https://civictax-municipal-property-tax-system.onrender.com
VITE_API_BASE_URL=https://civictax-municipal-property-tax-system.onrender.com

# Enable the Salesforce-backed property service through the Express Gateway.
# Other frontend domain services still use local data and require migration before full production use.
VITE_USE_SALESFORCE=true

# Fallback Backend URL
VITE_BACKEND_URL=https://civictax-municipal-property-tax-system.onrender.com

# Public Application Name
VITE_APP_NAME=CIVICTAX

# Default Language ('en' for English, 'ta' for Tamil)
VITE_DEFAULT_LANGUAGE=en

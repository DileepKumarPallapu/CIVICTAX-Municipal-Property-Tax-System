# CivicTax Frontend Environment Configuration (Vercel Project 1: Root Directory ./)

# Primary Backend API Base URL (Deployed CivicTax Backend on Vercel)
# Local: http://localhost:3001
# Production: https://<your-backend-project>.vercel.app
VITE_API_BASE_URL=https://<your-backend-project>.vercel.app

# Application Operating Mode: 'local' (offline demo) or 'salesforce' (connected via Express Gateway)
VITE_DATA_PROVIDER=local

# Fallback Backend URL
VITE_BACKEND_URL=https://<your-backend-project>.vercel.app

# Public Application Name
VITE_APP_NAME=CIVICTAX

# Default Language ('en' for English, 'ta' for Tamil)
VITE_DEFAULT_LANGUAGE=en
